{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "AllowOurSesConfigurationSetsToPublish",
      "Effect": "Allow",
      "Principal": { "Service": "ses.amazonaws.com" },
      "Action": "sns:Publish",
      "Resource": "arn:aws:sns:ap-southeast-2:<ACCOUNT_ID>:oshc-ses-events",
      "Condition": {
        "StringEquals": { "AWS:SourceAccount": "<ACCOUNT_ID>" },
        "ArnLike": { "AWS:SourceArn": "arn:aws:ses:ap-southeast-2:<ACCOUNT_ID>:configuration-set/oshc-*" }
      }
    }
  ]
}
